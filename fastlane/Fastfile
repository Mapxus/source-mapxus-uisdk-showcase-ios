# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#


# Specify the project scheme name
scheme = "UISDKKmpSample"
icon_path = './UISDKKmpSample/Assets.xcassets/AppIcon.appiconset/1024.png'
ipa_dir = "./fastlane_build"

COMPANIES = %w[mapxus kawasaki]
DEFAULT_COMPANY = "mapxus"

default_platform(:ios)

def resolve_company(options)
  company = (options[:com] || DEFAULT_COMPANY).to_s.downcase
  unless COMPANIES.include?(company)
    UI.user_error!("Unknown com:#{company}. Supported: #{COMPANIES.join(', ')}")
  end
  company
end

def flavor_config_path(company)
  File.expand_path("../BuildConfig/Config.#{company}.xcconfig", __dir__)
end

# Reads a setting out of the flavor xcconfig so it stays the single source of truth.
def flavor_config_value(company, key)
  path = flavor_config_path(company)
  line = File.readlines(path).find { |l| l =~ /\A\s*#{Regexp.escape(key)}\s*=/ }
  UI.user_error!("#{key} is not defined in #{path}") if line.nil?
  line.split("=", 2).last.strip
end

def ensure_flavor_config!(company)
  path = flavor_config_path(company)
  unless File.exist?(path)
    UI.user_error!("Missing #{path}. Copy BuildConfig/Config.example.xcconfig to BuildConfig/Config.#{company}.xcconfig and fill in the real values.")
  end

  %w[MAPXUS_API_KEY MAPXUS_SECRET].each do |key|
    value = flavor_config_value(company, key)
    if value.empty? || value.start_with?("YOUR_")
      UI.user_error!("#{key} is still a placeholder in #{path}.")
    end
  end
end

platform :ios do

  #######################################################################################################################################
  #######################################################################################################################################
  #######################################################################################################################################

  before_all do |lane|
    # Clean build artifacts
    clear_derived_data

    # Install third-party dependencies
    cocoapods(use_bundle_exec: true, repo_update: true)

  end

  #######################################################################################################################################
  #######################################################################################################################################
  #######################################################################################################################################

  desc "Upload the package to fir.im. Usage: fastlane fir com:mapxus | fastlane fir com:kawasaki"
  lane :fir do |options|

    company = resolve_company(options)
    ensure_flavor_config!(company)

    bundle_id = flavor_config_value(company, "PRODUCT_BUNDLE_IDENTIFIER")
    ipa_name = "#{scheme}-#{company}.ipa"

    UI.message("Building flavor '#{company}' (#{bundle_id})")

    # Request the development certificate as well; otherwise, Xcode automatic signing may create extra development certificates
    match(type: "development", app_identifier: bundle_id)
    match(type: "adhoc", app_identifier: bundle_id)

    # Use gym to build, package, and sign the app.
    # The flavor xcconfig is passed via -xcconfig so it overrides the template
    # the project is based on, without touching any tracked file.
    gym(
      output_directory: ipa_dir,
      output_name: ipa_name,
      clean: true,
      workspace: scheme + ".xcworkspace",
      scheme: scheme,
      configuration: "Release",
      xcconfig: flavor_config_path(company),
      export_method: 'ad-hoc',
      xcargs: "-allowProvisioningUpdates"
    )

    change_log = changelog_from_git_commits(merge_commit_filtering: "exclude_merges")

    # upload app
    fir_cli(
      specify_file_path: "#{ipa_dir}/#{ipa_name}",
      skip_update_icon: false,
      specify_icon_file: icon_path,
      api_token: ENV['fir_api_token'],  
      changelog: change_log
    )

  end
end
